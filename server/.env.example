MONGODB_URI=mongodb+srv://your-connection-string-here
PORT=5000
# Long random string used to sign admin JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-here
NODE_ENV=development

# CORS: comma-separated exact origins allowed to call the API with credentials.
CLIENT_URL=http://localhost:3000
CLIENT_URLS=http://localhost:3000
# Optional: comma-separated host suffixes to allow (matched on label boundary),
# e.g. "vercel.app" allows any *.vercel.app deployment.
ALLOWED_ORIGIN_SUFFIXES=

# Email configuration (for contact form)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
# Use an app-specific password, never your real account password.
EMAIL_PASS=your-email-app-password

# Admin credentials for /api/admin/login
ADMIN_USERNAME=admin
# bcrypt hash of the admin password. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" "yourPassword"
ADMIN_PASSWORD_HASH=your-bcrypt-password-hash
